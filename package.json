{
  "name": "feed-cleaner-for-facebook",
  "version": "2.2.1",
  "description": "Unofficial Facebook feed cleaner userscript (hides sponsored/suggested posts, Reels, Stories)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.debug.config.ts",
    "build:main": "vite build",
    "build:debug": "vite build --config vite.debug.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "cuzic",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-monkey": "^8.1.0"
  }
}
